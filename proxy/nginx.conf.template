# plandrop front proxy — the dev/test stand-in for the production front proxy
# (NPM/Cloudflare/etc.) that lives OUTSIDE this stack. It routes by Host on a
# SINGLE published port so a browser and the CLI share one domain:
#
#   <parent domain>   -> ingress  (bare parent: /.plandrop/* statics + /api proxy)
#   *.<parent domain> -> apache   (tenant vhosts: static hosting + WebDAV writes)
#   anything else     -> 421      (refused; see the default server at the end)
#
# This is the same routing the production front proxy performs; it is the ONE
# proxy definition shared by the automated harness (test/setup/stack.ts brings
# this service up behind the `testproxy` profile) and manual browser testing.
# Never started by a plain/production `docker compose up`.
worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events { worker_connections 1024; }

http {
  default_type application/octet-stream;
  access_log   /dev/stdout;

  # Keep runtime state writable for a non-root run.
  client_body_temp_path /tmp/client_body;
  proxy_temp_path       /tmp/proxy;
  fastcgi_temp_path     /tmp/fastcgi;
  uwsgi_temp_path       /tmp/uwsgi;
  scgi_temp_path        /tmp/scgi;

  # Docker's embedded DNS. Resolving the upstreams through it (with variable
  # proxy_pass below) defers name resolution to request time, so the proxy
  # starts even if ingress/apache are not yet registered in DNS.
  resolver 127.0.0.11 ipv6=off valid=10s;

  # Dot-prefixed path segments die at the front door, whatever the method: a
  # hidden name is configuration or private data by convention (.git, .env,
  # .ssh, the CLI's own .plandrop credential file), and nothing a plandrop host
  # publishes is meant to be either. Refusing here saves the backend hop
  # entirely and puts a passive floor under whatever has already been uploaded.
  #
  # Three exceptions, each an exact shape rather than a pattern:
  #
  #   .plandrop/  — the shared theme NAMESPACE, excepted at ANY depth, which is
  #                 load-bearing: a document whose asset links are
  #                 document-relative asks for them from its own directory, so
  #                 they arrive as /plans/.plandrop/<theme>/… , which Apache
  #                 folds back onto the one shared tree. The bare `.plandrop`,
  #                 with no trailing slash, is deliberately NOT excepted — that
  #                 shape is the credential file, never the namespace.
  #   .header.html
  #   .footer.html — the tenant's own autoindex chrome. Apache names these as
  #                  dotfiles (HeaderName/ReadmeName) so they stay out of the
  #                  listing they decorate, but they are content a tenant
  #                  publishes on purpose, so both the upload and the read have
  #                  to survive this rule. Excepted at any depth, since the
  #                  chrome is per-directory, and only as whole basenames — a
  #                  `.header.html.bak` is still refused.
  #
  # A bonus layer, not the boundary. An operator who fronts the stack with their
  # own proxy (NPM, Cloudflare, …) inherits none of this, so Apache remains the
  # authoritative guard against WebDAV writes into the reserved name.
  map $uri $plandrop_hidden_path {
    default 0;
    "~/[.](?!plandrop/)(?!header[.]html$)(?!footer[.]html$)" 1;
  }

  # Tenants upload via WebDAV (PUT) — don't cap the body, and preserve the Host
  # header so Apache's mod_vhost_alias resolves the per-tenant docroot.
  client_max_body_size 0;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  # Bare parent domain -> ingress (control entrypoint).
  server {
    listen ${PLANDROP_PROXY_PORT};
    server_name ${PLANDROP_PROXY_DOMAIN};

    if ($plandrop_hidden_path) {
      return 403;
    }

    location / {
      set $upstream "${PLANDROP_INGRESS_HOST}:${PLANDROP_INGRESS_PORT}";
      proxy_pass http://$upstream;
    }
  }

  # Tenant vhosts: any subdomain of the parent domain -> apache, which picks the
  # docroot from the first host label. The wildcard matches at any depth
  # (a.parent and a.b.parent alike) but never the bare parent itself, so the two
  # blocks cannot both claim a host.
  server {
    listen ${PLANDROP_PROXY_PORT};
    server_name *.${PLANDROP_PROXY_DOMAIN};

    if ($plandrop_hidden_path) {
      return 403;
    }

    location / {
      set $upstream "${PLANDROP_APACHE_HOST}:${PLANDROP_APACHE_PORT}";
      proxy_pass http://$upstream;
    }
  }

  # Any other Host is refused here rather than routed. nginx always has a default
  # server for a listening address, and an unmarked configuration silently
  # promotes the FIRST block to the role — so this one claims `default_server`
  # explicitly, and it answers instead of proxying. Without it, either the
  # tenants or the control entrypoint would inherit every unmatched Host: a
  # request naming any name at all, or the host's bare IP address, would be
  # served real content.
  #
  # 421 Misdirected Request, with a body, rather than nginx's connection-drop
  # (444): the reader is nearly always the person running this stack, pointing a
  # browser or curl at an address that does not match the domain they configured.
  # A dropped connection is indistinguishable from a proxy that is down or a
  # network fault, and sends them to debug the wrong thing; a status line and one
  # sentence name the actual mistake. Nothing legitimate reaches this proxy on a
  # name other than the configured domain, so there is nothing here to hide.
  server {
    listen ${PLANDROP_PROXY_PORT} default_server;
    server_name _;
    default_type text/plain;

    # The Host is never echoed back: it is attacker-controlled and this body is
    # returned to whoever sent it.
    return 421 "plandrop: this proxy serves ${PLANDROP_PROXY_DOMAIN} (the control entrypoint) and its subdomains (published documents). The request named a different host, so it was not routed. Set PLANDROP_PROXY_DOMAIN to the domain you reach this stack by.\n";
  }
}
